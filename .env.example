# ---------------------------------------------------------------------------
# Society Management — environment variables
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real values.
# ---------------------------------------------------------------------------

# === REQUIRED ===============================================================

# Postgres connection string.
# For Supabase, use the SESSION POOLER (port 5432) from:
#   Dashboard -> Connect -> Session pooler
# Do NOT use the transaction pooler (port 6543): the dev session store is
# connect-pg-simple, which needs a persistent connection and prepared
# statements. server/db.ts also switches SSL behaviour on the port number.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Secret used to sign session cookies. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this logs everyone out. Never ship the code's built-in fallback.
SESSION_SECRET=

# === OPTIONAL ===============================================================

# Port the Express server listens on locally. Defaults to 3000.
PORT=3000

# "development" or "production". Affects session store, cookie security
# (secure + sameSite=strict) and whether Vite dev middleware is mounted.
NODE_ENV=development

# === GOOGLE OAUTH (optional) ===============================================
# If CLIENT_ID and CLIENT_SECRET are both unset, the Google strategy is simply
# not registered and "Sign in with Google" is disabled. Local login still works.
# Two existing users are Google-only and cannot log in without these set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to /api/auth/google/callback
GOOGLE_CALLBACK_URL=

# === EMAIL / SMTP (optional) ===============================================
# Used only by the admin storage-management reports
# (server/routes/storage-management.ts). Sending fails without these; the rest
# of the app is unaffected.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@societymanagement.com

# === PLATFORM-SET (do not set manually) ====================================
# VERCEL   - set to "1" by Vercel. Disables cron jobs and the listen() call.
# REPL_ID  - set by Replit. Enables the cartographer Vite plugin.
